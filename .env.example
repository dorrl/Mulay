# Server
PORT=33541
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATA_DIR=./data
# Set true only when running behind one trusted reverse proxy.
TRUST_PROXY=false

# Google Cloud Console > APIs & Services > Credentials > OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/server/auth/google/callback

# YouTube Data API v3 key. Keep this on the server; never prefix it with VITE_.
YOUTUBE_API_KEY=

# Admin accounts: comma-separated Google profile IDs and/or verified email addresses.
ADMIN_GOOGLE_IDS=
ADMIN_EMAILS=
